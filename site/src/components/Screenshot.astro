---
// A screenshot of the app.
//
//   <Screenshot name="lighting" alt="The Lighting page" />
//
// Images: src/assets/screens/<lang>/<light|dark>/<name>.webp, taken by
// tools/screenshots (sample data, a stand-in keyboard). The project keeps
// English dark-theme shots only (owner's decision, 2026-11-12): a Turkish page
// shows the English shot, and one shot serves both site themes. When a page
// has both a light and a dark shot, each theme shows its own. While a shot is
// missing, a labelled placeholder keeps the page building.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  alt: string;
  caption?: string;
}
const { name, alt, caption } = Astro.props;
const lang = Astro.currentLocale === "tr" ? "tr" : "en";
const shots = import.meta.glob<{ default: ImageMetadata }>("/src/assets/screens/*/*/*.webp", { eager: true });
const pick = (theme: "light" | "dark") =>
  shots[`/src/assets/screens/${lang}/${theme}/${name}.webp`]?.default ??
  shots[`/src/assets/screens/en/${theme}/${name}.webp`]?.default;
const light = pick("light");
const dark = pick("dark");
const only = light && dark ? null : (dark ?? light);
const sizes = "(max-width: 900px) 100vw, 760px";
---

<figure class="km-shot not-content">
  {
    light && dark ? (
      <>
        <Image src={light} alt={alt} class="dark:sl-hidden" widths={[720, 1080, light.width]} sizes={sizes} />
        <Image src={dark} alt={alt} class="light:sl-hidden" widths={[720, 1080, dark.width]} sizes={sizes} />
      </>
    ) : only ? (
      <Image src={only} alt={alt} widths={[720, 1080, only.width]} sizes={sizes} />
    ) : (
      <div class="km-shot-missing" role="img" aria-label={alt}>
        <span>{name}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
