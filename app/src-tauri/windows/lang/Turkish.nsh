; Turkish texts of the installer (bundle.windows.nsis.customLanguageFiles).
; They replace Tauri's own file, so every key Tauri's template uses must be here:
; after a Tauri update, compare with target/release/nsis/x64/Turkish.nsh.
; kmWelcome* are ours (installer-hooks.nsh). Plain words, no technical terms.
LangString addOrReinstall ${LANG_TURKISH} "Yeniden kur"
LangString alreadyInstalled ${LANG_TURKISH} "Zaten kurulu"
LangString alreadyInstalledLong ${LANG_TURKISH} "${PRODUCTNAME} ${VERSION} bu bilgisayarda zaten kurulu. Ne yapmak istediğinizi seçip İleri'ye tıklayın."
LangString appRunning ${LANG_TURKISH} "${PRODUCTNAME} açık. Önce uygulamayı kapatıp yeniden deneyin."
LangString appRunningOkKill ${LANG_TURKISH} "${PRODUCTNAME} açık.$\nKapatmak için Tamam'a tıklayın."
LangString chooseMaintenanceOption ${LANG_TURKISH} "Ne yapmak istediğinizi seçin."
LangString chooseHowToInstall ${LANG_TURKISH} "${PRODUCTNAME} nasıl kurulsun?"
LangString createDesktop ${LANG_TURKISH} "Masaüstüne kısayol koy"
LangString dontUninstall ${LANG_TURKISH} "Kaldırmadan devam et"
LangString dontUninstallDowngrade ${LANG_TURKISH} "Kaldırmadan devam et (eski bir sürümü kurmak için önce yenisini kaldırmanız gerekir)"
LangString failedToKillApp ${LANG_TURKISH} "${PRODUCTNAME} kapatılamadı. Uygulamayı kendiniz kapatıp yeniden deneyin."
LangString installingWebview2 ${LANG_TURKISH} "Gereken Windows bileşeni (WebView2) kuruluyor..."
LangString newerVersionInstalled ${LANG_TURKISH} "Bu bilgisayarda ${PRODUCTNAME} uygulamasının daha yeni bir sürümü kurulu. Eski sürümü kurmanız önerilmez; gerçekten istiyorsanız önce yeni sürümü kaldırın. Ne yapmak istediğinizi seçip İleri'ye tıklayın."
LangString older ${LANG_TURKISH} "daha eski"
LangString olderOrUnknownVersionInstalled ${LANG_TURKISH} "Bu bilgisayarda ${PRODUCTNAME} uygulamasının $R4 bir sürümü kurulu. Kurmadan önce onu kaldırmanız önerilir. Ne yapmak istediğinizi seçip İleri'ye tıklayın."
LangString silentDowngrades ${LANG_TURKISH} "Bu kurulum dosyasıyla eski bir sürüm sessizce kurulamaz. Kurulum dosyasını çift tıklayarak açın.$\n"
LangString unableToUninstall ${LANG_TURKISH} "Kaldırılamadı."
LangString uninstallApp ${LANG_TURKISH} "${PRODUCTNAME} uygulamasını kaldır"
LangString uninstallBeforeInstalling ${LANG_TURKISH} "Kurmadan önce kaldır"
LangString unknown ${LANG_TURKISH} "bilinmeyen"
LangString webview2AbortError ${LANG_TURKISH} "Gereken Windows bileşeni (WebView2) kurulamadı; uygulama onsuz çalışmaz. Kurulumu yeniden başlatmayı deneyin."
LangString webview2DownloadError ${LANG_TURKISH} "Gereken Windows bileşeni (WebView2) indirilemedi: $0"
LangString webview2DownloadSuccess ${LANG_TURKISH} "Gereken Windows bileşeni indirildi"
LangString webview2Downloading ${LANG_TURKISH} "Gereken Windows bileşeni (WebView2) indiriliyor..."
LangString webview2InstallError ${LANG_TURKISH} "Gereken Windows bileşeni (WebView2) kurulamadı (hata kodu $1)."
LangString webview2InstallSuccess ${LANG_TURKISH} "Gereken Windows bileşeni kuruldu"
LangString deleteAppData ${LANG_TURKISH} "Ayarlarımı ve kayıtlarımı da sil"
LangString kmWelcomeTitle ${LANG_TURKISH} "${PRODUCTNAME} kurulumuna hoş geldiniz"
LangString kmWelcomeText ${LANG_TURKISH} "${PRODUCTNAME}, klavyenizin ışıklarını, tuşlarını ve ekranını yönetmenizi sağlar.$\r$\n$\r$\nKurulum yalnızca sizin hesabınıza yapılır, yönetici izni istemez ve birkaç saniye sürer.$\r$\n$\r$\nDevam etmek için İleri'ye tıklayın."
