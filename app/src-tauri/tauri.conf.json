{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keymotion",
  "version": "0.1.0",
  "identifier": "dev.keymotion",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keymotion",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "Keymotion",
    "copyright": "Copyright © 2026 Keymotion contributors",
    "homepage": "https://github.com/cebersaban44-rgb/keymotion",
    "license": "MIT OR Apache-2.0",
    "shortDescription": "Lighting, keys and screen for your keyboard",
    "longDescription": "Keymotion controls the lighting, key assignments, macros and screen of AJAZZ AK980 PRO keyboards on Windows, and shows a focus timer, reminders, calendar cards and system gauges on the keys and the screen.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
