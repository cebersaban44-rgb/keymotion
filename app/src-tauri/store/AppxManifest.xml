<?xml version="1.0" encoding="utf-8"?>
<!--
  Keymotion's Microsoft Store package (MSIX). tools/store/msix.mjs fills the
  {{…}} places and packs it with the same keymotion.exe the GitHub release
  has; docs site: developers/microsoft-store.

  {{IdentityName}}, {{Publisher}}, {{PublisherDisplayName}}: Partner Center
    › the app › Product identity, copied exactly (case counts); a local
    test package uses its own made-up values.
  {{Version}}: the app's version and a fourth part 0 (the Store keeps that
    part); the Store wants the first part above 0.

  Full trust (runFullTrust): the program runs as it does from the NSIS
  installer, at the user's normal rights, outside the app sandbox. The app
  needs it to talk to the keyboard over HID with the Win32 calls, to read
  the system gauges and the running programs, and to show its tray icon.

  Two applications: Keymotion itself, and keymotion-cli, the command-line
  tool AI coding agents and scripts use (crates/keymotion-cli). The tool is
  a console program with no tile and no Start menu entry; Windows puts its
  app execution alias, keymotion-cli.exe, in
  %LOCALAPPDATA%\Microsoft\WindowsApps, which is on PATH. It talks only to
  the running Keymotion, over a local named pipe, and never opens the
  keyboard. The app's id stays "Keymotion" (keymotion-cli starts the app by
  it: crates/keymotion-cli/src/launch.rs APP_ID).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop desktop4 rescap">

  <Identity
    Name="{{IdentityName}}"
    Publisher="{{Publisher}}"
    Version="{{Version}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DisplayName}}</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Lighting, keys and screen for your keyboard</Description>
  </Properties>

  <!-- Windows 10 2004 or later: uap10 below needs it. WebView2 is not
       declared: Windows 11 and updated Windows 10 already have it, and a
       Store install would ignore the declaration. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <!-- The Store lists the app in these languages (the app's own); makepri's
       /dq in tools/store/msix.mjs names the same four. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="tr-tr" />
    <Resource Language="ru-ru" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application Id="Keymotion" Executable="keymotion.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DisplayName}}"
        Description="Lighting, keys and screen for your keyboard"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- "Start with Windows" (channel.rs STARTUP_TASK): off until the
             user turns it on in Settings › Background; it starts the app in
             the tray, as the GitHub build's Run value does with hidden. -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="keymotion.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--hidden">
          <desktop:StartupTask TaskId="KeymotionStartup" Enabled="false" DisplayName="Keymotion" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <!-- keymotion-cli: a console tool, run by its alias from a terminal or
         a coding agent's hook, many at once; no tile, nothing in the Start
         menu. -->
    <Application Id="Cli" Executable="keymotion-cli.exe" EntryPoint="Windows.FullTrustApplication" desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Keymotion command line"
        Description="Keymotion for scripts and AI agents"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="keymotion-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="keymotion-cli.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
